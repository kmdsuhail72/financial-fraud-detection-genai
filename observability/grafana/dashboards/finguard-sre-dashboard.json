{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "FinGuard Golden Signals & RED Metrics",
      "type": "row"
    },
    {
      "id": 1,
      "title": "HTTP Request Throughput (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (method, status)",
          "legendFormat": "{{method}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 5xx Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "100 * (sum(rate(http_requests_total{status=~\"5..\"}[1m])) / sum(rate(http_requests_total[1m])))",
          "legendFormat": "5xx Error Rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1.0 }
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "id": 3,
      "title": "Fraud Scoring Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(fraud_scoring_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p50 (median) ms"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(fraud_scoring_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95 ms (SLO < 200ms)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(fraud_scoring_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p99 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "SLO & Error Budget Governance",
      "type": "row"
    },
    {
      "id": 4,
      "title": "Core API Availability SLO Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "100 * (1 - (sum(rate(http_requests_total{status=~\"5..\"}[30d])) / sum(rate(http_requests_total[30d]))))",
          "legendFormat": "30d Availability %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99.5 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "id": 5,
      "title": "Remaining Error Budget (%)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "finguard_error_budget_remaining_percent",
          "legendFormat": "Budget Remaining %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "orange", "value": 25 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "id": 6,
      "title": "Active SRE Incident Alerts",
      "type": "alertlist",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 9 },
      "options": {
        "show": "current",
        "stateFilter": { "firing": true, "pending": true }
      }
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["finguard", "sre", "observability", "opentelemetry", "prometheus"],
  "time": { "from": "now-6h", "to": "now" },
  "title": "FinGuard AI — Enterprise SRE & Observability Dashboard",
  "uid": "finguard-sre-obs-v1",
  "version": 1
}
