# ==============================================================================
# FinGuard AI - Environment Configuration Template
# NOTE: Do NOT place real production secrets or credentials in this file.
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# Application Configuration
APP_NAME=FinGuard AI
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# AWS Infrastructure Settings
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# S3 Data Lake & Storage
S3_BUCKET_NAME=finguard-data-dev
S3_BRONZE_PREFIX=bronze/transactions/
S3_SILVER_PREFIX=silver/transactions/
S3_GOLD_PREFIX=gold/fraud-analytics/

# Kinesis Streaming Pipeline
KINESIS_STREAM_NAME=finguard-transactions-dev
KINESIS_SHARD_COUNT=2
KINESIS_CONSUMER_BATCH_SIZE=100

# PostgreSQL Operational Database
DATABASE_URL=postgresql://finguard:CHANGE_ME@localhost:5432/finguard
POSTGRES_USER=finguard
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=finguard
POSTGRES_PORT=5432

# Fraud Model & Scoring Engine
MODEL_NAME=xgboost
FRAUD_THRESHOLD=0.80
ANOMALY_THRESHOLD=0.60
RISK_WEIGHT_SUPERVISED=0.65
RISK_WEIGHT_ANOMALY=0.35

# Amazon Bedrock Generative AI
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_TEMPERATURE=0.1
BEDROCK_MAX_TOKENS=1024

# Security, Authentication & Access Control
JWT_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# FastAPI Server Settings
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Monitoring & Alerting
CLOUDWATCH_NAMESPACE=FinGuardAI/Metrics
ALERT_SNS_TOPIC_ARN=

